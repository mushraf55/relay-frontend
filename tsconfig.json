{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-taste/types/**/*.ts",
    ".next-taste/dev/types/**/*.ts",
    ".next-final/types/**/*.ts",
    ".next-final/dev/types/**/*.ts",
    ".next-release/types/**/*.ts",
    ".next-release/dev/types/**/*.ts",
    ".next-ui/types/**/*.ts",
    ".next-ui/dev/types/**/*.ts",
    ".next-chatbots-ui/types/**/*.ts",
    ".next-chatbots-ui/dev/types/**/*.ts",
    ".next-impeccable/types/**/*.ts",
    ".next-impeccable/dev/types/**/*.ts",
    ".next-chat-ui/types/**/*.ts",
    ".next-chat-ui/dev/types/**/*.ts",
    ".next-sidebar-ui/types/**/*.ts",
    ".next-sidebar-ui/dev/types/**/*.ts",
    ".next-workspace-redesign/types/**/*.ts",
    ".next-workspace-redesign/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
